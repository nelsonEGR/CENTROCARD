# --------------------------------------------------------------------
# Plantilla de variables de entorno (copiar a .env)
#
# Uso rapido:
#   cp .env.example .env   (o copiar/pegar en Windows)
#   docker compose up --build -d
#
# El contenedor consume estas variables y genera el .env interno de
# CodeIgniter en tiempo de arranque. Nunca subas el archivo .env real.
# --------------------------------------------------------------------

# Entorno de la aplicacion: development | testing | production
CI_ENVIRONMENT=development

# URL base con la que se sirve la aplicacion
# Local:      http://centrocar.test/
# Produccion: https://tu-dominio.com/
APP_BASE_URL=http://centrocar.test/

# --------------------------------------------------------------------
# PostgreSQL (Neon u otro servidor accesible por red)
# --------------------------------------------------------------------
DB_HOSTNAME=tu-endpoint.neon.tech
DB_DATABASE=centrocard
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
DB_PORT=5432
DB_SCHEMA=public
# Neon requiere SSL. Para Postgres local sin SSL usar "disable".
DB_SSLMODE=require
# Endpoint del pooler de Neon (dejar vacio si no aplica).
DB_OPTIONS=

# --------------------------------------------------------------------
# Parametros de negocio
# --------------------------------------------------------------------
IMPUESTO=10
GANANCIA=25

# --------------------------------------------------------------------
# Opciones del contenedor
# --------------------------------------------------------------------
# Ejecuta migraciones y seeder al arrancar (true/false).
RUN_MIGRATIONS=false
