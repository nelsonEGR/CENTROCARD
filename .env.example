# Entorno local Docker. Docker Compose ya provee estos valores, por lo que
# no es necesario copiar este archivo para iniciar el proyecto localmente.
CI_ENVIRONMENT = development

app.baseURL = 'https://centrocar.dev/'
app.indexPage = ''

# PostgreSQL local dentro de Docker Compose.
database.default.hostname = database
database.default.database = centrocard
database.default.username = centrocard
database.default.password = centrocard
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.schema = public
database.default.sslmode = disable
database.default.options = ''

IMPUESTO = 10
GANANCIA = 25
