#--------------------------------------------------------------------
# ENTORNO
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
# app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE (PostgreSQL / Neon)
# Copia este archivo a .env y coloca tus credenciales reales.
#--------------------------------------------------------------------
database.default.hostname = your-host.neon.tech
database.default.database = your_database
database.default.username = your_user
database.default.password = your_password
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.schema = public
database.default.sslmode = require
database.default.options = 'endpoint=your-endpoint-id'

#--------------------------------------------------------------------
# NEGOCIO
#--------------------------------------------------------------------
IMPUESTO=10
GANANCIA=25
